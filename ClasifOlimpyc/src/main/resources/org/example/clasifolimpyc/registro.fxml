<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
            fx:controller="CONTROLLER_NAME"
            prefHeight="400.0" prefWidth="600.0" alignment="CENTER" spacing="10.0">
    <Label text="Registro de Usuario" />
    <Label text="Nombre completo:" />
    <TextField fx:id="txtNombreCompleto" promptText="Ingrese su nombre completo" maxWidth="300" />
    <Label text="Edad:" />
    <TextField fx:id="txtEdad" promptText="Ingrese su edad" maxWidth="100" />
    <Label text="Correo electrónico:" />
    <TextField fx:id="txtCorreo" promptText="Ingrese su correo electrónico" maxWidth="300" />

    <Label text="Seleccione su grupo:" />
    <ComboBox fx:id="comboGrupos" maxWidth="200" />
    <HBox alignment="CENTER" spacing="10.0">
        <Button text="Registrar" onAction="#Registrar" />
        <Button text="Ver Participantes" onAction="#SaltarVentanaGrupos" />
    </HBox>



</VBox>
